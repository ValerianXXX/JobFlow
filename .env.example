# Optional visual transcription. The application reads process environment;
# this file is an example, not automatically loaded. Default remains off.
JOBFLOW_VISUAL_ENABLE=false
# Required for existing Hermes/Agent routes: rendered pages follow that Agent's
# configured provider and may leave the device. It is not a local-only guarantee.
JOBFLOW_VISUAL_ALLOW_CONFIGURED_PROVIDER=false
# PDF rendering for the opt-in visual route: integer 110..300, default 220.
# Higher resolution changes image payload and can increase provider cost.
# The old 110-DPI path misread fixed scan probes. No automatic downsampling,
# silent partial document, local OCR fallback, or Claim approval is performed.
JOBFLOW_VISUAL_PDF_DPI=220
# Limits: 25 MP/page, 60 MP/document, six pages, 6 MiB encoded image payload.
# Split an oversized source explicitly. See docs/scan-resolution-2026-10-29.md.

# Optional model-free PDF text parser with page coordinates. Empty keeps the
# existing parser. pdf_regions uses the already-required pdfplumber dependency
# and proposes column reading order; docling_native needs the optional .[document].
# PDF only, <=16 MiB / 6 pages, no OCR. It runs locally but downstream Claim
# analysis still uses the model/provider you configure in JobFlow.
# Explicit selection takes precedence over PDF visual transcription and never
# falls back to a cloud route after failure. Images use the visual setting above.
JOBFLOW_DOCUMENT_PARSER=
# See docs/pdf-regions-and-cjk-2026-10-29.md for the measured limits. Ruled
# tables keep row order; unruled table/column ambiguity still requires review.

# The PDF-master standard-resume entry formats already approved wording locally.
# It needs no new model setting. Word registration and preview tools are detected
# separately; a detected Word installation is not a successful export receipt.
# See docs/standard-resume-2026-10-29.md for review, adoption and conversion checks.

# Optional local Word-free PDF export. Default word keeps the existing path.
# Set libreoffice only after installing/trusting it and reviewing sample output.
# No automatic installation, provider fallback or cloud upload is performed.
JOBFLOW_PDF_EXPORT_PROVIDER=word
# Set an absolute binary path only for a nonstandard installation. On Windows
# use program/soffice.com (not soffice.exe). An invalid explicit path blocks use.
# JOBFLOW_LIBREOFFICE_BINARY=C:/Program Files/LibreOffice/program/soffice.com
# See docs/local-pdf-export-2026-10-29.md for the measured compatibility limits.

# Optional MCP is a separate stdio process: python -m jobops.mcp_server --project PATH
# It reads redacted application metadata only; no port, model key or mail access.
