{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/ats-capability-report.schema.json",
  "title": "Offline ATS Capability Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "provider_count", "providers", "live_site_accessed", "browser_actions", "network_actions", "real_external_actions"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"const": "OFFLINE_ATS_CAPABILITIES"},
    "provider_count": {"type": "integer", "minimum": 1},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "offline_evidence_level", "saved_snapshot_modes", "route_shape", "dynamic_control_strategy", "guest_first", "account_creation_blocked", "upload_blocked", "submit_blocked", "live_site_verified", "user_present_prefill", "approved_material_upload", "nonfinal_navigation", "final_submit", "live_compatibility", "browser_actions", "network_actions", "real_external_actions", "transport_contract_hash", "live_transport_registered", "automatic_retry", "contract_hash"],
        "properties": {
          "provider": {"enum": ["company", "workday", "greenhouse", "lever"]},
          "offline_evidence_level": {"enum": ["DIRECT_SNAPSHOT_PASS", "SYNTHETIC_VERTICAL_PASS", "SINGLE_SNAPSHOT_PASS", "SAVED_SEQUENCE_PASS"]},
          "saved_snapshot_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["single_html", "provider_json", "ordered_html_sequence"]}},
          "route_shape": {"enum": ["OFFICIAL_DIRECT", "OFFICIAL_TO_APPROVED_ATS"]},
          "dynamic_control_strategy": {"enum": ["opaque_control_ref", "logical_field_hash"]},
          "guest_first": {"const": true},
          "account_creation_blocked": {"const": true},
          "upload_blocked": {"const": true},
          "submit_blocked": {"const": true},
          "live_site_verified": {"const": false},
          "user_present_prefill": {"const": "SUPPORTED_WITH_RUNTIME_REVALIDATION"},
          "approved_material_upload": {"const": "SUPPORTED_WITH_RUNTIME_REVALIDATION"},
          "nonfinal_navigation": {"const": "SUPPORTED_EXPLICIT_CONTROLS_ONLY"},
          "final_submit": {"const": "USER_ONLY"},
          "live_compatibility": {"const": "NOT_UNIVERSALLY_VERIFIED"},
          "browser_actions": {"const": 0},
          "network_actions": {"const": 0},
          "real_external_actions": {"const": 0},
          "transport_contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "live_transport_registered": {"const": false},
          "automatic_retry": {"const": false},
          "contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "live_site_accessed": {"const": false},
    "browser_actions": {"const": 0},
    "network_actions": {"const": 0},
    "real_external_actions": {"const": 0}
  }
}
