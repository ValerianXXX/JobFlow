{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobflow.local/schemas/installed-pointer-v2.schema.json",
  "title": "JobFlow installed complete-runtime pointer v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version_directory", "version", "source_commit", "source_payload_sha256", "runtime_closure_manifest_sha256", "runtime_tree_sha256", "release_key_id", "bootstrap_version", "platform"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "product": {"type": "string", "const": "JobFlow"},
    "version_directory": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{12}$"},
    "version": {"$ref": "#/$defs/version"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "source_payload_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_tree_sha256": {"$ref": "#/$defs/sha256"},
    "release_key_id": {"type": "string", "const": "sha256:1037057f8578a60ac5b3dc030cb2d70ad945ec3b5fb51fa3944fcafa77146339"},
    "bootstrap_version": {"$ref": "#/$defs/version"},
    "platform": {"type": "string", "const": "windows-x64"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
