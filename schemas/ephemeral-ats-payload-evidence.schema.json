{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/ephemeral-ats-payload-evidence.schema.json",
  "title": "Isolated Ephemeral ATS Payload Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "application_id", "application_context_hash",
    "browser_plan_hash", "form_snapshot_hash", "field_count", "file_count",
    "field_binding_hash", "material_binding_hash", "application_answer_bundle_count",
    "confirmed_stop_field_count", "skipped_optional_field_count", "synthetic_only",
    "production_activation", "temporary_files_removed", "private_values_emitted",
    "browser_actions", "network_actions", "real_external_actions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ISOLATED_EPHEMERAL_PAYLOAD_VALIDATED"},
    "application_id": {"type": "string", "pattern": "^APP-[A-F0-9]{12}$"},
    "application_context_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "browser_plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "form_snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "field_count": {"type": "integer", "minimum": 0},
    "file_count": {"type": "integer", "minimum": 1},
    "field_binding_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "material_binding_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "application_answer_bundle_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "confirmed_stop_field_count": {"type": "integer", "minimum": 0},
    "skipped_optional_field_count": {"type": "integer", "minimum": 0},
    "synthetic_only": {"const": true},
    "production_activation": {"const": false},
    "temporary_files_removed": {"const": true},
    "private_values_emitted": {"const": 0},
    "browser_actions": {"const": 0},
    "network_actions": {"const": 0},
    "real_external_actions": {"const": 0}
  }
}
