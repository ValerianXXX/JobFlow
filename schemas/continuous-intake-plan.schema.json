{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/continuous-intake-plan.schema.json",
  "title": "Manual Continuous Intake Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "plan_hash", "job_count", "pending_limit", "awaiting_approval", "reserved_slots", "existing_deferred", "slots_available", "jobs_eligible_this_tick", "jobs_expected_to_defer", "requires_explicit_invocation", "background_service_started", "system_tasks_registered", "browser_actions", "network_actions", "real_external_actions"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["MANUAL_TICK_READY", "PAUSED_AT_PENDING_LIMIT"]},
    "mode": {"const": "MANUAL_TICK_ONLY"},
    "plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "job_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "pending_limit": {"type": "integer", "minimum": 1, "maximum": 1000},
    "awaiting_approval": {"type": "integer", "minimum": 0},
    "reserved_slots": {"type": "integer", "minimum": 0},
    "existing_deferred": {"type": "integer", "minimum": 0},
    "slots_available": {"type": "integer", "minimum": 0},
    "jobs_eligible_this_tick": {"type": "integer", "minimum": 0},
    "jobs_expected_to_defer": {"type": "integer", "minimum": 0},
    "requires_explicit_invocation": {"const": true},
    "background_service_started": {"const": false},
    "system_tasks_registered": {"const": 0},
    "browser_actions": {"const": 0},
    "network_actions": {"const": 0},
    "real_external_actions": {"const": 0}
  }
}
