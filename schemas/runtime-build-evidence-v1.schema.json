{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobflow.local/schemas/runtime-build-evidence-v1.schema.json",
  "title": "JobFlow sanitized runtime build evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "evidence_kind",
    "issued_at_utc",
    "expires_at_utc",
    "application_version",
    "source_commit",
    "platform",
    "structural_status",
    "archive",
    "runtime_closure",
    "python_source",
    "build_inputs",
    "build_inputs_sha256",
    "deterministic_build",
    "independent_verification",
    "offline_smoke",
    "closure_self_claims",
    "external_actions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "format": {"type": "string", "const": "JOBFLOW_RUNTIME_BUILD_EVIDENCE_V1"},
    "evidence_kind": {"type": "string", "const": "SANITIZED_BUILD_OBSERVATION"},
    "issued_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "application_version": {"$ref": "#/$defs/version"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "platform": {"type": "string", "const": "windows-x64"},
    "structural_status": {"type": "string", "const": "BUILT_UNATTESTED"},
    "archive": {"$ref": "#/$defs/archive"},
    "runtime_closure": {"$ref": "#/$defs/runtimeClosure"},
    "python_source": {"$ref": "#/$defs/pythonSource"},
    "build_inputs": {"$ref": "#/$defs/buildInputs"},
    "build_inputs_sha256": {"$ref": "#/$defs/sha256"},
    "deterministic_build": {"$ref": "#/$defs/deterministicBuild"},
    "independent_verification": {"$ref": "#/$defs/independentVerification"},
    "offline_smoke": {"$ref": "#/$defs/offlineSmoke"},
    "closure_self_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sigstore_verified", "outer_signature_ready"],
      "properties": {
        "sigstore_verified": {"type": "boolean", "const": false},
        "outer_signature_ready": {"type": "boolean", "const": false}
      }
    },
    "external_actions": {"type": "integer", "const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$",
      "format": "date-time"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "archive_prefix"],
      "properties": {
        "name": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64-complete\\.zip$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1610612736},
        "sha256": {"$ref": "#/$defs/sha256"},
        "archive_prefix": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64/$"}
      }
    },
    "runtimeClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "tree_sha256",
        "source_payload_sha256",
        "file_count",
        "total_bytes",
        "python_version",
        "platform"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_payload_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "python_version": {"$ref": "#/$defs/version"},
        "platform": {"type": "string", "const": "windows-x64"}
      }
    },
    "pythonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifact_name",
        "artifact_bytes",
        "artifact_sha256",
        "sigstore_bundle_name",
        "sigstore_bundle_bytes",
        "sigstore_bundle_sha256"
      ],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "artifact_name": {"type": "string", "pattern": "^python-[0-9]+\\.[0-9]+\\.[0-9]+-embed-amd64\\.zip$"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "sigstore_bundle_name": {"type": "string", "pattern": "^python-[0-9]+\\.[0-9]+\\.[0-9]+-embed-amd64\\.zip\\.sigstore$"},
        "sigstore_bundle_bytes": {"type": "integer", "minimum": 1},
        "sigstore_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "buildInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_wheel_lock_sha256",
        "build_wheel_lock_sha256",
        "wheelhouse_tree_sha256",
        "application_wheel_sha256",
        "application_wheel_provenance",
        "builder_toolchain_sha256",
        "runtime_wheel_count",
        "build_wheel_count"
      ],
      "properties": {
        "runtime_wheel_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_wheel_lock_sha256": {"$ref": "#/$defs/sha256"},
        "wheelhouse_tree_sha256": {"$ref": "#/$defs/sha256"},
        "application_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "application_wheel_provenance": {"$ref": "#/$defs/applicationWheelProvenance"},
        "builder_toolchain_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_wheel_count": {"type": "integer", "minimum": 1},
        "build_wheel_count": {"type": "integer", "minimum": 1}
      }
    },
    "applicationWheelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "source_commit",
        "source_git_tree_oid",
        "source_build_tree_sha256",
        "source_archive_sha256",
        "build_lock_sha256",
        "build_recipe_sha256",
        "pass_a_wheel_sha256",
        "pass_b_wheel_sha256",
        "reproducible"
      ],
      "properties": {
        "format": {"type": "string", "const": "JOBFLOW_APPLICATION_WHEEL_PROVENANCE_V1"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_git_tree_oid": {"$ref": "#/$defs/commit"},
        "source_build_tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "build_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "pass_a_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "pass_b_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "reproducible": {"type": "boolean", "const": true}
      }
    },
    "deterministicBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_a_archive_sha256",
        "pass_b_archive_sha256",
        "pass_a_tree_sha256",
        "pass_b_tree_sha256",
        "match"
      ],
      "properties": {
        "pass_a_archive_sha256": {"$ref": "#/$defs/sha256"},
        "pass_b_archive_sha256": {"$ref": "#/$defs/sha256"},
        "pass_a_tree_sha256": {"$ref": "#/$defs/sha256"},
        "pass_b_tree_sha256": {"$ref": "#/$defs/sha256"},
        "match": {"type": "boolean", "const": true}
      }
    },
    "independentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifier_sha256", "archive_sha256", "closure_manifest_sha256", "tree_sha256"],
      "properties": {
        "status": {"type": "string", "const": "PASS"},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "offlineSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result_token", "archive_sha256", "closure_manifest_sha256", "tree_sha256", "external_actions"],
      "properties": {
        "status": {"type": "string", "const": "PASS"},
        "result_token": {"type": "string", "const": "JOBFLOW_OFFLINE_SMOKE_OK"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "external_actions": {"type": "integer", "const": 0}
      }
    }
  }
}
