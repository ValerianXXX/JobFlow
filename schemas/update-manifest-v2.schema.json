{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobflow.local/schemas/update-manifest-v2.schema.json",
  "title": "JobFlow signed complete-runtime update manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "channel", "release", "predecessor", "asset", "runtime_closure", "publisher_attestation", "policy", "issued_at_utc"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "product": {"type": "string", "const": "JobFlow"},
    "channel": {"type": "string", "const": "stable"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "platform"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "platform": {"type": "string", "const": "windows-x64"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "maximum_version_exclusive", "disallow_downgrade", "require_current_runtime_closure"],
      "properties": {
        "minimum_version": {"$ref": "#/$defs/version"},
        "maximum_version_exclusive": {"$ref": "#/$defs/version"},
        "disallow_downgrade": {"type": "boolean", "const": true},
        "require_current_runtime_closure": {"type": "boolean", "const": true}
      }
    },
    "legacy_v1_predecessors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/legacyV1Predecessor"}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "archive_prefix"],
      "properties": {
        "name": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64-complete\\.zip$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1610612736},
        "sha256": {"$ref": "#/$defs/sha256"},
        "archive_prefix": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64/$"}
      }
    },
    "runtime_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "tree_sha256", "structural_status", "source_commit", "source_payload_sha256", "file_count", "total_bytes", "python_version", "platform", "build_inputs"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "structural_status": {"type": "string", "const": "BUILT_UNATTESTED"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_payload_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "python_version": {"$ref": "#/$defs/version"},
        "platform": {"type": "string", "const": "windows-x64"},
        "build_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python_artifact_sha256", "wheel_lock_sha256", "wheelhouse_tree_sha256", "application_wheel_sha256", "application_wheel_provenance", "builder_toolchain_sha256", "wheel_count"],
          "properties": {
            "python_artifact_sha256": {"$ref": "#/$defs/sha256"},
            "wheel_lock_sha256": {"$ref": "#/$defs/sha256"},
            "wheelhouse_tree_sha256": {"$ref": "#/$defs/sha256"},
            "application_wheel_sha256": {"$ref": "#/$defs/sha256"},
            "application_wheel_provenance": {"$ref": "#/$defs/applicationWheelProvenance"},
            "builder_toolchain_sha256": {"$ref": "#/$defs/sha256"},
            "wheel_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "publisher_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "format", "release_key_id", "evidence_format", "runtime_build_evidence_sha256", "publisher_evidence_sha256", "evidence_expires_at_utc", "signer_readiness_challenge_sha256", "runtime_closure_manifest_sha256", "runtime_tree_sha256", "build_inputs_sha256", "source_commit", "source_payload_sha256", "file_count", "total_bytes", "policy_sha256", "issued_at_utc"],
      "properties": {
        "status": {"type": "string", "const": "ATTESTED"},
        "format": {"type": "string", "const": "JOBFLOW_PUBLISHER_ATTESTATION_V2"},
        "release_key_id": {"type": "string", "const": "sha256:1037057f8578a60ac5b3dc030cb2d70ad945ec3b5fb51fa3944fcafa77146339"},
        "evidence_format": {"type": "string", "const": "JOBFLOW_PUBLISHER_EVIDENCE_V1"},
        "runtime_build_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "publisher_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_expires_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
        "signer_readiness_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_tree_sha256": {"$ref": "#/$defs/sha256"},
        "build_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_payload_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_updater_version", "minimum_bootstrap_version", "required_structural_status", "publisher_attestation_required", "final_submit_user_only", "automatic_retry_submission_unknown", "external_actions_during_update"],
      "properties": {
        "minimum_updater_version": {"$ref": "#/$defs/version"},
        "minimum_bootstrap_version": {"$ref": "#/$defs/version"},
        "required_structural_status": {"type": "string", "const": "BUILT_UNATTESTED"},
        "publisher_attestation_required": {"type": "boolean", "const": true},
        "final_submit_user_only": {"type": "boolean", "const": true},
        "automatic_retry_submission_unknown": {"type": "boolean", "const": false},
        "external_actions_during_update": {"type": "integer", "const": 0}
      }
    },
    "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "legacySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "applicationWheelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "source_commit",
        "source_git_tree_oid",
        "source_build_tree_sha256",
        "source_archive_sha256",
        "build_lock_sha256",
        "build_recipe_sha256",
        "pass_a_wheel_sha256",
        "pass_b_wheel_sha256",
        "reproducible"
      ],
      "properties": {
        "format": {"type": "string", "const": "JOBFLOW_APPLICATION_WHEEL_PROVENANCE_V1"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_git_tree_oid": {"$ref": "#/$defs/commit"},
        "source_build_tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "build_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "pass_a_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "pass_b_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "reproducible": {"type": "boolean", "const": true}
      }
    },
    "legacyV1Predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "version", "source_sha256", "version_directory"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "version": {"$ref": "#/$defs/version"},
        "source_sha256": {"$ref": "#/$defs/legacySha256"},
        "version_directory": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{12}$"}
      }
    }
  }
}
