{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/continuous-intake-descriptor.schema.json",
  "title": "Saved Manual Continuous Intake Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "intake_key", "job", "created_at", "real_external_actions", "descriptor_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "READY_FOR_MANUAL_CONTINUATION"},
    "intake_key": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "profile_ref", "master_resume_ref", "answer_bank_ref", "synthetic"],
      "properties": {
        "input": {"type": "string", "minLength": 1, "maxLength": 512},
        "profile_ref": {"type": "string", "pattern": "^secure-ref:[A-Za-z0-9_-]{8,128}$"},
        "master_resume_ref": {"type": "string", "pattern": "^secure-ref:[A-Za-z0-9_-]{8,128}$"},
        "answer_bank_ref": {"type": "string", "pattern": "^secure-ref:[A-Za-z0-9_-]{8,128}$"},
        "external_claim_set_ref": {"type": "string", "pattern": "^secure-ref:[A-Za-z0-9_-]{8,128}$"},
        "tailoring_manifest_ref": {"type": "string", "pattern": "^secure-ref:[A-Za-z0-9_-]{8,128}$"},
        "route": {"type": "string", "minLength": 1, "maxLength": 512},
        "form": {"type": "string", "minLength": 1, "maxLength": 512},
        "research": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_type": {"enum": ["txt", "html", "pdf", "snapshot"]},
        "synthetic": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "real_external_actions": {"const": 0},
    "descriptor_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
