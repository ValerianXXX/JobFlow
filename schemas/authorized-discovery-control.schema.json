{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/authorized-discovery-control.schema.json",
  "title": "Authorized read-only discovery control",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "configured", "enabled", "paused", "pause_reason", "generation", "interval_minutes", "authorized_until", "next_run_at", "last_run_at", "last_run_status", "consecutive_failures", "max_new_per_run", "inbox_limit", "source_count", "task_registration_state", "run_active", "read_only_network_authorized", "application_actions_authorized", "browser_actions_authorized", "material_upload_authorized", "final_submit", "automatic_retry", "updated_at", "control_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["NOT_CONFIGURED", "READY", "DUE", "PAUSED", "AUTHORIZATION_EXPIRED", "RUNNING"]},
    "mode": {"const": "AUTHORIZED_READ_ONLY_DISCOVERY"},
    "configured": {"type": "boolean"},
    "enabled": {"type": "boolean"},
    "paused": {"type": "boolean"},
    "pause_reason": {"type": ["string", "null"], "enum": [null, "USER_PAUSED", "USER_KILL_SWITCH", "REPEATED_FAILURES"]},
    "generation": {"type": "integer", "minimum": 0},
    "interval_minutes": {"type": ["integer", "null"], "minimum": 60, "maximum": 1440},
    "authorized_until": {"type": ["string", "null"], "format": "date-time"},
    "next_run_at": {"type": ["string", "null"], "format": "date-time"},
    "last_run_at": {"type": ["string", "null"], "format": "date-time"},
    "last_run_status": {"type": ["string", "null"], "enum": [null, "COMPLETED", "COMPLETED_WITH_ERRORS", "FAILED", "STOPPED_STALE"]},
    "consecutive_failures": {"type": "integer", "minimum": 0},
    "max_new_per_run": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
    "inbox_limit": {"type": ["integer", "null"], "minimum": 10, "maximum": 1000},
    "source_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "task_registration_state": {"enum": ["NOT_REGISTERED", "REGISTRATION_REQUIRED", "REGISTERED", "REMOVAL_REQUIRED", "UNKNOWN"]},
    "run_active": {"type": "boolean"},
    "read_only_network_authorized": {"type": "boolean"},
    "application_actions_authorized": {"const": false},
    "browser_actions_authorized": {"const": false},
    "material_upload_authorized": {"const": false},
    "final_submit": {"const": "USER_ONLY"},
    "automatic_retry": {"const": false},
    "updated_at": {"type": "string", "format": "date-time"},
    "control_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
