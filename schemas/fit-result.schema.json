{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/fit-result.schema.json",
  "title": "Fit Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["eligibility_status", "hard_gaps", "unknowns", "dimensions", "overall_score", "recommendation", "explanation"],
  "properties": {
    "eligibility_status": {"enum": ["ELIGIBLE", "INELIGIBLE", "NEEDS_USER_INPUT"]},
    "hard_gaps": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "capability", "evidence", "industry", "level", "location", "preference"],
      "properties": {
        "function": {"$ref": "#/$defs/dimension"}, "capability": {"$ref": "#/$defs/dimension"}, "evidence": {"$ref": "#/$defs/dimension"},
        "industry": {"$ref": "#/$defs/dimension"}, "level": {"$ref": "#/$defs/dimension"}, "location": {"$ref": "#/$defs/dimension"}, "preference": {"$ref": "#/$defs/dimension"}
      }
    },
    "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
    "recommendation": {"enum": ["RECOMMEND", "CONDITIONAL", "DO_NOT_APPLY"]},
    "explanation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "evidence", "calculation", "gaps", "confidence", "decision_impact"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "calculation": {"type": "string"}, "gaps": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}, "decision_impact": {"type": "string"}
      }
    }
  }
}
