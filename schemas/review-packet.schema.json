{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/schemas/review-packet.schema.json",
  "title": "Application Review Packet",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "packet_id", "application_id", "job", "jd_captured_at", "fit", "hard_gaps", "resume_bullets", "master_resume_diff", "form_questions", "sensitive_fields", "uploads", "material_plan", "execution_plan", "external_actions", "source_route", "queue", "ai_operator", "content_hash"],
  "properties": {
    "schema_version": {"const": 1}, "status": {"enum": ["AWAITING_APPROVAL", "APPROVED", "REJECTED", "NEEDS_REVISION"]},
    "packet_id": {"type": "string", "pattern": "^RPK-[A-F0-9]{12}$"}, "application_id": {"type": "string", "pattern": "^APP-[A-F0-9]{12}$"},
    "job": {"type": "object"}, "jd_captured_at": {"type": "string", "format": "date-time"}, "fit": {"type": "object"},
    "hard_gaps": {"type": "array"}, "resume_bullets": {"type": "array"}, "master_resume_diff": {"type": ["array", "object"]},
    "form_questions": {"type": "array"}, "sensitive_fields": {"type": "array"}, "uploads": {"type": "array", "minItems": 1},
    "material_plan": {"type": "object"},
    "execution_plan": {
      "type": "object",
      "required": ["plan_hash", "status", "steps", "live_transport_registered", "stop_before_final_submission", "real_external_actions"],
      "properties": {
        "plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "status": {"enum": ["READY_FOR_REVIEW", "NEEDS_USER_INPUT", "NEEDS_ACCOUNT_APPROVAL"]},
        "steps": {"type": "array", "minItems": 6},
        "live_transport_registered": {"const": false},
        "stop_before_final_submission": {"const": true},
        "real_external_actions": {"const": 0}
      }
    },
    "external_actions": {"type": "array", "minItems": 1, "items": {"enum": ["create_recruiting_account", "upload_material", "submit_application", "send_email", "contact_recruiter", "withdraw_application", "accept_legal_terms", "electronic_signature"]}},
    "source_route": {"type": "object"}, "queue": {"type": "object"},
    "ai_operator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operator_task_id", "turns", "final_submit", "automatic_retry", "private_values_exposed", "real_external_actions"],
      "properties": {
        "schema_version": {"const": 1},
        "operator_task_id": {"type": ["string", "null"], "pattern": "^AIT-[A-F0-9]{12}$"},
        "turns": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["schema_version", "operator_run_id", "task_id", "application_id", "decision_point", "task_state_hash", "selected_tool", "result_hash", "final_submit", "automatic_retry", "private_values_exposed", "real_external_actions", "turn_id"],
            "properties": {
              "schema_version": {"const": 1},
              "operator_run_id": {"type": "string", "pattern": "^AOR-[A-F0-9]{12}$"},
              "turn_id": {"type": "string", "pattern": "^AOT-[A-F0-9]{12}$"},
              "task_id": {"type": "string", "pattern": "^(AIT|APP)-[A-F0-9]{12}$"},
              "application_id": {"type": ["string", "null"], "pattern": "^APP-[A-F0-9]{12}$"},
              "decision_point": {"enum": ["JOB_AND_MATERIAL_DECISION", "CURRENT_FORM_SEMANTIC_REVIEW"]},
              "task_state_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "selected_tool": {"enum": ["jobflow.plan_resume_changes", "jobflow.inspect_application_form"]},
              "result_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "final_submit": {"const": "USER_ONLY"},
              "automatic_retry": {"const": false},
              "private_values_exposed": {"const": 0},
              "real_external_actions": {"const": 0}
            }
          }
        },
        "final_submit": {"const": "USER_ONLY"},
        "automatic_retry": {"const": false},
        "private_values_exposed": {"const": 0},
        "real_external_actions": {"const": 0}
      }
    },
    "execution_bundle_content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
