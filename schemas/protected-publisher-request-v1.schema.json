{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobflow.local/schemas/protected-publisher-request-v1.schema.json",
  "title": "JobFlow protected publisher request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "status",
    "release",
    "archive",
    "runtime_build_evidence",
    "runtime_closure",
    "build_inputs_sha256",
    "python_source",
    "pinned_policy",
    "required_response",
    "safety"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "format": {"type": "string", "const": "JOBFLOW_PROTECTED_PUBLISHER_REQUEST_V1"},
    "status": {"type": "string", "const": "AWAITING_PROTECTED_PUBLISHER_EVIDENCE"},
    "release": {"$ref": "#/$defs/release"},
    "archive": {"$ref": "#/$defs/archive"},
    "runtime_build_evidence": {"$ref": "#/$defs/runtimeBuildEvidence"},
    "runtime_closure": {"$ref": "#/$defs/runtimeClosure"},
    "build_inputs_sha256": {"$ref": "#/$defs/sha256"},
    "python_source": {"$ref": "#/$defs/pythonSource"},
    "pinned_policy": {"$ref": "#/$defs/pinnedPolicy"},
    "required_response": {"$ref": "#/$defs/requiredResponse"},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$",
      "format": "date-time"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "platform"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "platform": {"type": "string", "const": "windows-x64"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "archive_prefix"],
      "properties": {
        "name": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64-complete\\.zip$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1610612736},
        "sha256": {"$ref": "#/$defs/sha256"},
        "archive_prefix": {"type": "string", "pattern": "^JobFlow-v[0-9]+\\.[0-9]+\\.[0-9]+-windows-x64/$"}
      }
    },
    "runtimeBuildEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "issued_at_utc", "expires_at_utc"],
      "properties": {
        "name": {"type": "string", "const": "JobFlow-runtime-build-evidence.json"},
        "bytes": {"type": "integer", "minimum": 2, "maximum": 262144},
        "sha256": {"$ref": "#/$defs/sha256"},
        "issued_at_utc": {"$ref": "#/$defs/utc"},
        "expires_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "runtimeClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "tree_sha256", "source_payload_sha256", "file_count", "total_bytes"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_payload_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "pythonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "artifact_bytes", "artifact_sha256", "sigstore_bundle_name", "sigstore_bundle_bytes", "sigstore_bundle_sha256"],
      "properties": {
        "artifact_name": {"type": "string", "pattern": "^python-[0-9]+\\.[0-9]+\\.[0-9]+-embed-amd64\\.zip$"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "sigstore_bundle_name": {"type": "string", "pattern": "^python-[0-9]+\\.[0-9]+\\.[0-9]+-embed-amd64\\.zip\\.sigstore$"},
        "sigstore_bundle_bytes": {"type": "integer", "minimum": 1},
        "sigstore_bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pinnedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows_runtime_source_sha256", "update_channel_sha256", "release_key_id", "sigstore_certificate_identity", "sigstore_certificate_oidc_issuer"],
      "properties": {
        "windows_runtime_source_sha256": {"$ref": "#/$defs/sha256"},
        "update_channel_sha256": {"$ref": "#/$defs/sha256"},
        "release_key_id": {"type": "string", "const": "sha256:1037057f8578a60ac5b3dc030cb2d70ad945ec3b5fb51fa3944fcafa77146339"},
        "sigstore_certificate_identity": {"type": "string", "const": "thomas@python.org"},
        "sigstore_certificate_oidc_issuer": {"type": "string", "const": "https://accounts.google.com"}
      }
    },
    "requiredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_name", "format", "status", "maximum_bytes", "signer_challenge_format"],
      "properties": {
        "name": {"type": "string", "const": "JobFlow-publisher-evidence.json"},
        "schema_name": {"type": "string", "const": "publisher-evidence-v1"},
        "format": {"type": "string", "const": "JOBFLOW_PUBLISHER_EVIDENCE_V1"},
        "status": {"type": "string", "const": "READY_FOR_PROTECTED_SIGNING"},
        "maximum_bytes": {"type": "integer", "const": 262144},
        "signer_challenge_format": {"type": "string", "const": "JOBFLOW_SIGNER_READINESS_CHALLENGE_V1"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_contains_local_paths", "request_contains_secret_material", "protected_key_required_by_request", "external_actions"],
      "properties": {
        "request_contains_local_paths": {"type": "boolean", "const": false},
        "request_contains_secret_material": {"type": "boolean", "const": false},
        "protected_key_required_by_request": {"type": "boolean", "const": false},
        "external_actions": {"type": "integer", "const": 0}
      }
    }
  }
}
