{
  "manifest_version": 3,
  "name": "JobFlow Browser Companion",
  "version": "0.4.0",
  "description": "Guided read-only job import plus user-present company/ATS prefill, approved Next/Continue navigation, and material attachment. JobFlow never clicks final Submit.",
  "key": "",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "JobFlow"},
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["pair.js"],
      "run_at": "document_start"
    }
  ]
}
